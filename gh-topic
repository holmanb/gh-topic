#!/usr/bin/env bash
# gh-topic — per-topic directories, addressed by PR.
#
# A topic is a local clone of the current repo on a branch named after
# the topic, with a PR. Topic directories live under
# GH_TOPIC_ROOT/gh-topic (default: $XDG_DATA_HOME/gh-topic), named <repo>-<branch>.

set -euo pipefail

die() {
    echo "gh-topic: $*" >&2
    exit 1
}
usage() {
    echo "usage: gh topic new <name> [--open]" >&2
    echo "       gh topic goto <branch-or-pr> [--open]" >&2
    echo "       gh topic gc [--dry-run] [--force]" >&2
    echo "       gh topic ls" >&2
    exit 2
}

root=${GH_TOPIC_ROOT:-${XDG_DATA_HOME:-$HOME/.local/share}}/gh-topic
editor=${GH_TOPIC_EDITOR:-code}
repo=$(gh repo view --json name -q .name)

cmd_new() {
    local branch dir open='' opt args=()
    # flags may come in any order
    for opt in "$@"; do
        case $opt in
            --open) open=1 ;;
            *) args+=("$opt") ;;
        esac
    done
    [ ${#args[@]} -eq 1 ] || usage
    branch=${args[0]}
    require_branch "$branch"
    dir=$(clone_topic "$branch")
    git -C "$dir" checkout -b "$branch" >&2 ||
        {
            rm -rf "$dir"
            die "cannot check out $branch"
        }
    # an IDE failure still prints the path
    [ -n "$open" ] && { $editor "$dir" >&2 || true; }
    echo "$dir"
}

cmd_goto() {
    local arg open='' dir branch opt args=()
    # flags may come in any order
    for opt in "$@"; do
        case $opt in
            --open) open=1 ;;
            *) args+=("$opt") ;;
        esac
    done
    [ ${#args[@]} -eq 1 ] || usage
    arg=${args[0]}
    branch=$(branch_for_pr "$arg")
    require_branch "$branch"
    dir=$(topic_dir "$branch")
    # create on first goto
    if [ ! -d "$dir" ]; then
        # a new topic needs a PR: a number argument already resolved to
        # one above, a branch argument is checked here by name. A fork's
        # PR is invisible to gh's by-name lookup, so numbers must not
        # go through it
        if ! is_pr "$arg"; then
            gh pr view "$branch" --json number > /dev/null || die "no PR for branch $branch"
        fi
        origin_has_branch "$arg" "$branch"
        dir=$(clone_topic "$branch")
        checkout_topic_branch "$dir" "$branch"
    else
        # an existing dir must be the topic: an interrupted goto
        # leaves a clone on its initial branch
        require_topic_branch "$dir" "$branch"
    fi
    # an IDE failure still prints the path
    [ -n "$open" ] && { $editor "$dir" >&2 || true; }
    echo "$dir"
}

# branch → PR number and state, from a single gh pr list call.
# A temp file avoids bash 4 associative arrays; awk looks up by branch.
# Dies if the API call fails, so ls and gc never silently show stale data.
load_prs() {
    local tmp
    tmp=$(mktemp) || die "cannot create temp file"
    # External jq avoids gh's internal -q flag, which fails when stdout is redirected.
    gh pr list --state all --json number,headRefName,state \
        --limit 1000 | jq -r '.[] | "\(.number)\t\(.headRefName)\t\(.state)"' \
        > "$tmp" || {
        rm -f "$tmp"
        die "cannot list PRs"
    }
    echo "$tmp"
}

cmd_gc() {
    local dry='' force='' status=0 opt dir branch state prs
    for opt in "$@"; do
        case $opt in
            --dry-run) dry=1 ;;
            --force) force=1 ;;
            *) usage ;;
        esac
    done
    prs=$(load_prs)
    for dir in "$root/$repo"-*/; do
        # no topics
        [ -d "$dir" ] || continue
        dir=${dir%/}
        branch=${dir#"$root/$repo"-}
        branch=$(dirname_to_branch "$branch")
        state=$(awk -F'\t' -v b="$branch" '$2==b {print $3; found=1; exit} END {exit !found}' "$prs") || continue
        case $state in MERGED | CLOSED) ;; *) continue ;; esac
        if [ -n "$(unmerged_changes "$dir")" ] && [ -z "$force" ]; then
            echo "gh-topic: keeping $dir (unmerged changes)" >&2
            status=1
            continue
        fi
        if [ -n "$dry" ]; then
            echo "would remove $dir"
        else
            rm -rf "$dir"
            echo "removed $dir"
        fi
    done
    rm -f "$prs"
    exit "$status"
}

cmd_ls() {
    local dir branch pr prs
    prs=$(load_prs)
    for dir in "$root/$repo"-*/; do
        # no topics
        [ -d "$dir" ] || continue
        dir=${dir%/}
        branch=${dir#"$root/$repo"-}
        branch=$(dirname_to_branch "$branch")
        pr=$(awk -F'\t' -v b="$branch" '$2==b {print $1; found=1; exit} END {exit !found}' "$prs") || pr='-'
        printf '%s\t%s\t%s\n' "$pr" "$dir" "$branch"
    done
    rm -f "$prs"
}

# branch → percent-encoded directory name
branch_to_dirname() {
    local s=$1
    s=${s//%/%25}
    s=${s//\//%2F}
    echo "$s"
}
# percent-encoded directory name → branch
dirname_to_branch() {
    local s=$1
    s=${s//%2F//}
    s=${s//%25/%}
    echo "$s"
}

topic_dir() { echo "$root/$repo-$(branch_to_dirname "$1")"; }

# a local clone inherits the parent's
# shape; refuse the shapes it can't
require_cloneable_parent() {
    local src=$1 why=()
    [ "$(git -C "$src" rev-parse --is-shallow-repository)" = false ] || why+=(shallow)
    [ -z "$(git -C "$src" config --get-regexp '^remote\..*\.promisor$' || true)" ] || why+=(partial)
    [ ! -e "$(git -C "$src" rev-parse --absolute-git-dir)/objects/info/alternates" ] || why+=(alternates)
    [ "$(git -C "$src" rev-parse --show-object-format)" = sha1 ] || why+=(sha256)
    [ ${#why[@]} -eq 0 ] || die "cannot clone locally: parent is ${why[*]}"
}

# dir ← parent's remotes, origin repaired
copy_remotes() {
    local dir=$1 src=$2 name
    while read -r name; do
        [ "$name" = origin ] && continue
        git -C "$dir" remote add "$name" "$(git -C "$src" remote get-url "$name")" ||
            return 1
    done < <(git -C "$src" remote)
}

# branch → fresh topic dir, printed
clone_topic() {
    local branch=$1 dir src origin_url
    dir=$(topic_dir "$branch")
    [ ! -e "$dir" ] || die "$dir already exists"
    src=$(git rev-parse --show-toplevel)
    require_cloneable_parent "$src"
    origin_url=$(git -C "$src" remote get-url origin 2> /dev/null) ||
        die "parent repo has no origin remote"
    # plain clone: hardlinks or copies
    git clone --quiet "$src" "$dir" >&2 ||
        {
            rm -rf "$dir"
            die "cannot clone $src"
        }
    copy_remotes "$dir" "$src" ||
        {
            rm -rf "$dir"
            die "cannot copy remotes"
        }
    # gh resolves the repo from remotes
    git -C "$dir" remote set-url origin "$origin_url" ||
        {
            rm -rf "$dir"
            die "cannot set origin"
        }
    echo "$dir"
}

# whether a goto argument is a PR number
is_pr() { [[ $1 =~ ^[0-9]+$ ]]; }

# arg, branch → present on origin, or die with a factual cause, before any
# clone is made. The argument decides the diagnosis: a number addresses
# a fork's PR (a by-name lookup cannot), so cross-fork is the answer
# there; a branch argument names a base-repo PR, and a base PR whose
# branch is gone has had its head deleted — the normal merged state.
origin_has_branch() {
    local arg=$1 branch=$2
    if ! git ls-remote --exit-code origin "refs/heads/$branch" > /dev/null 2>&1; then
        if is_pr "$arg" &&
            gh pr view "$arg" --json isCrossRepository -q .isCrossRepository 2> /dev/null | grep -qx true; then
            die "cross-fork PRs are not supported yet (PR $arg's head branch $branch lives on a fork)"
        fi
        die "no branch $branch on origin (merged PRs have their head branch deleted)"
    fi
}

# name → dies unless it can be a branch: git allows a leading dash
# as a ref name but not as a command-line argument, so no command
# could pass it through; the rules for the rest come from git itself
require_branch() {
    local name=$1
    case $name in
        '' | -*) die "'$name' is not a valid branch name" ;;
    esac
    git check-ref-format "refs/heads/$name" ||
        die "'$name' is not a valid branch name"
}

# PR number → branch; branch names pass through
branch_for_pr() {
    local arg=$1
    if is_pr "$arg"; then
        gh pr view "$arg" --json headRefName -q .headRefName ||
            die "no PR $arg"
    else
        echo "$arg"
    fi
}

# dir, branch → checked out, tracking origin. The presence of the ref
# was already proven pre-clone, so a failure here means the remote moved
# under us; -B because a head branch named like the clone's initial
# branch (e.g. a PR whose head is "main") would make -b refuse the name
checkout_topic_branch() {
    local dir=$1 branch=$2
    git -C "$dir" fetch --quiet origin "+refs/heads/$branch:refs/remotes/origin/$branch" >&2 ||
        {
            rm -rf "$dir"
            die "cannot fetch $branch from origin"
        }
    git -C "$dir" checkout -B "$branch" --track "origin/$branch" >&2 ||
        {
            rm -rf "$dir"
            die "cannot check out $branch"
        }
}

# dir, branch → dies unless the dir is a topic checked out on the
# branch: an interrupted goto leaves a clone on its initial branch,
# and a hand-made dir is not a topic at all
require_topic_branch() {
    local dir=$1 branch=$2
    [ "$(git -C "$dir" rev-parse --abbrev-ref HEAD 2> /dev/null)" = "$branch" ] ||
        die "$dir is not checked out on $branch (interrupted goto? remove it and retry)"
}

# dir → non-empty if work is not on a remote
unmerged_changes() {
    local dir=$1
    git -C "$dir" fetch --quiet > /dev/null 2>&1 || true
    if git -C "$dir" rev-parse --verify -q "@{u}" > /dev/null 2>&1; then
        git -C "$dir" log --oneline "@{u}..HEAD"
    else
        git -C "$dir" log --oneline --branches --not --remotes
    fi
    git -C "$dir" status --porcelain
}

[ $# -gt 0 ] || usage
case $1 in
    new)
        [ $# -ge 2 ] || usage
        cmd_new "${@:2}"
        ;;
    goto)
        [ $# -ge 2 ] || usage
        cmd_goto "${@:2}"
        ;;
    gc) cmd_gc "${@:2}" ;;
    ls) cmd_ls ;;
    *) usage ;;
esac
